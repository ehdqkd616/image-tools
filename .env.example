# 공통
APP_ENV=development
SECRET_KEY=change-me
FRONTEND_ORIGIN=http://localhost:5173
# nginx로 접속하는 주소 (쉼표로 여러 개)
ALLOWED_ORIGINS=http://localhost:8088
# HTTPS 운영 시 true
COOKIE_SECURE=false
# nginx 호스트 포트
WEB_PORT=8088
# 127.0.0.1이면 리버스 프록시(Caddy 등)를 거쳐서만 접속 가능. 외부에 직접 열려면 0.0.0.0
WEB_BIND=127.0.0.1
# GPU 워커를 기본으로 쓰려면 주석 해제
# COMPOSE_FILE=docker-compose.yml:docker-compose.gpu.yml

# DB / Redis
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=imagestudio
DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/imagestudio
REDIS_URL=redis://redis:6379/0

# 저장소
STORAGE_BACKEND=local            # local | s3
LOCAL_STORAGE_PATH=/data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto

# 제한
MAX_UPLOAD_MB=20
MAX_FILES_PER_REQUEST=20
MAX_IMAGE_PIXELS=50000000
UPSCALE_MAX_INPUT_PIXELS_2X=4000000
UPSCALE_MAX_INPUT_PIXELS_4X=1000000
UPSCALE_MAX_OUTPUT_SIDE=8000
DEFAULT_USER_QUOTA_MB=2048
FILE_RETENTION_DAYS=30
DELETED_GRACE_DAYS=7
SESSION_DAYS=7

# 업스케일 (realesrgan은 docker-compose.gpu.yml 과 함께 사용)
UPSCALE_ENGINE=lanczos           # lanczos | realesrgan
UPSCALE_DEVICE=cuda              # cuda | cpu
UPSCALE_TILE_SIZE=400
UPSCALE_HALF=false

# 회원가입 알림 메일 — 가입이 들어오면 아래 주소로 승인 요청 메일을 보낸다 (쉼표로 여러 명).
# Gmail은 보내는 계정에서 2단계 인증을 켜고 "앱 비밀번호"를 SMTP_PASSWORD에 넣는다.
# 메일 속 관리자 페이지 링크는 FRONTEND_ORIGIN을 쓴다.
ADMIN_NOTIFY_EMAILS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
